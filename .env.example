# Copiez ce fichier en .env.local et renseignez les valeurs de votre projet
# Supabase (Project Settings > API). La clé "anon" est publique par design
# (elle est protégée par les policies RLS) — ne mettez JAMAIS la clé
# service_role ici. Sans ces variables, l'application utilise le projet de
# production défini dans src/lib/supabaseClient.js.

VITE_SUPABASE_URL=https://<votre-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<votre-anon-key>
